# ATIF trajectory adapter architecture
#
# Compact render (12px regular-weight font, no internal step arrows — the
# numbering conveys the order, which lets elk lay the steps out in one row).
# Regenerate with:
#   d2 -l elk --elk-nodeNodeBetweenLayers 10 --elk-padding "[top=4,left=4,bottom=4,right=4]" \
#       --pad 0 --theme 1 --dark-theme 200 diagrams/atif-architecture.d2 \
#       public/images/diagrams/atif-architecture.svg
# ...then apply the Makefile `diagrams` target's sed color pass to the SVG.
direction: down

*.style.border-radius: 4
**.style.font-size: 12
**.style.bold: false

evalhub: EvalHub Server {
  direction: right
  api: REST API
  orch: Job Orchestrator
}

k8s: "Kubernetes / OpenShift" {
  direction: right
  cm: "ConfigMap\n/meta/job.json"
  input: "Input mount\n/test_data (ATIF JSON)"
  pod: ATIF Job Pod {
    adapter: ATIF Adapter {
      direction: right
      discover: "1. Discover + validate ATIF files"
      criteria: "2. Derive or load criteria"
      score: "3. Score steps (judge)"
      aggregate: "4. Aggregate + categorize failures"
      persist: "5. Persist artifacts"
    }
    sidecar: Sidecar
  }
}

external: External {
  direction: right
  judge: "Judge endpoint\n(OpenAI-compatible)"
  mlflow: MLflow
}

evalhub.orch -> k8s.cm: creates {
  style.font-size: 12
}
evalhub.orch -> k8s.pod: creates Job {
  style.font-size: 12
}
k8s.cm -> k8s.pod.adapter: mounted {
  style.font-size: 12
}
k8s.input -> k8s.pod.adapter: recorded trajectories {
  style.font-size: 12
}
k8s.pod.adapter.score -> external.judge: scoring requests {
  style.font-size: 12
}
k8s.pod.adapter.persist -> k8s.pod.sidecar: callbacks {
  style.font-size: 12
}
k8s.pod.sidecar -> evalhub.api: "POST /events" {
  style.font-size: 12
  style.stroke-dash: 3
}
k8s.pod.adapter.persist -> external.mlflow: "run + detailed artifacts" {
  style.font-size: 12
}
